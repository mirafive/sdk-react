{
  "name": "@mirafive/react",
  "version": "2.0.0",
  "description": "MIRA FIVE for React: a provider and hooks (useMira, useIdentify, useTrackOnMount) over @mirafive/web. SSR-safe, StrictMode-safe, no dependencies beyond MIRA FIVE's own.",
  "keywords": [
    "analytics",
    "attribution",
    "consent",
    "hooks",
    "mira-five",
    "mirafive",
    "react"
  ],
  "homepage": "https://github.com/mirafive/sdk-react#readme",
  "bugs": {
    "url": "https://github.com/mirafive/sdk-react/issues"
  },
  "license": "MIT",
  "author": "Cloo GmbH <hallo@mirafive.io> (https://mirafive.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirafive/sdk-react.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@mirafive/web": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "packageManager": "bun@1.4.4"
}
